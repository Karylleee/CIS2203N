<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header Row -->
    <RelativeLayout
        android:id="@+id/verses_header_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back_verses"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Back"
            app:tint="#1E1E1E" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_toEndOf="@id/btn_back_verses"
            android:layout_toStartOf="@id/btn_close_verses"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/verses_book_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John 1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E1E1E"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/verses_book_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Testament"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_verses"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Close"
            app:tint="#1E1E1E" />
    </RelativeLayout>

    <!-- Verses RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/verses_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/verses_header_layout"
        app:layout_constraintBottom_toTopOf="@id/verses_controls_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reading Settings Controls Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/verses_controls_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Font Size Slider Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/font_size_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="10"
                    android:progress="3"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textSize="20sp"
                    android:textColor="#1E1E1E"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bottom Navigation & Action Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Left capsule navigation segment -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_reference_chip"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_alignParentStart="true">

                    <ImageButton
                        android:id="@+id/btn_prev_chapter"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_chevron_left"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous Chapter"
                        app:tint="#1E1E1E" />

                    <TextView
                        android:id="@+id/text_chapter_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 of 50"
                        android:textSize="13sp"
                        android:textColor="#1E1E1E"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp" />

                    <ImageButton
                        android:id="@+id/btn_next_chapter"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_chevron_right"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next Chapter"
                        app:tint="#1E1E1E" />
                </LinearLayout>

                <!-- Right Settings Gear -->
                <ImageButton
                    android:id="@+id/btn_reading_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_settings"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Settings"
                    app:tint="#1E1E1E" />
            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
