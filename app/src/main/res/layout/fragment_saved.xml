<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Custom AppBar Header -->
    <RelativeLayout
        android:id="@+id/saved_appbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_back_saved"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="#1E1E1E" />

        <!-- Centered Title -->
        <TextView
            android:id="@+id/saved_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Bookmarks"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E" />

        <!-- AppBar Search Icon -->
        <ImageButton
            android:id="@+id/btn_appbar_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_search"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search Bookmarks Option"
            app:tint="#1E1E1E" />
    </RelativeLayout>

    <!-- Search bookmarks bar -->
    <LinearLayout
        android:id="@+id/search_bookmarks_card"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_box"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/saved_appbar">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search Icon"
            app:tint="#9E9E9E" />

        <EditText
            android:id="@+id/search_bookmarks_edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search bookmarks..."
            android:textSize="14sp"
            android:textColor="#1E1E1E"
            android:textColorHint="#9E9E9E"
            android:background="@android:color/transparent"
            android:layout_marginStart="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- Filter Tabs (All, Highlighted, Favorites) -->
    <LinearLayout
        android:id="@+id/saved_filter_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/search_bookmarks_card">

        <!-- ALL -->
        <TextView
            android:id="@+id/tab_saved_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A56DB"
            android:background="@drawable/bg_chapter_active"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- HIGHLIGHTED -->
        <TextView
            android:id="@+id/tab_saved_highlighted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Highlighted"
            android:textSize="14sp"
            android:textColor="#616161"
            android:background="@drawable/bg_chapter_normal"
            android:layout_marginStart="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- FAVORITES -->
        <TextView
            android:id="@+id/tab_saved_favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorites"
            android:textSize="14sp"
            android:textColor="#616161"
            android:background="@drawable/bg_chapter_normal"
            android:layout_marginStart="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:id="@+id/saved_tab_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/saved_filter_tabs" />

    <!-- Section Header (RECENT) -->
    <TextView
        android:id="@+id/recent_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RECENT"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#9E9E9E"
        android:letterSpacing="0.05"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/saved_tab_divider" />

    <!-- Saved Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/saved_verses_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recent_header" />

    <!-- Floating Action Button (FAB) bottom right -->
    <ImageButton
        android:id="@+id/fab_add_bookmark"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_add"
        android:background="@drawable/bg_fab_blue"
        android:contentDescription="Add Bookmark"
        android:elevation="6dp"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
