<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header layout -->
    <RelativeLayout
        android:id="@+id/home_header_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/home_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/daily_verse_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_verse_card">

            <!-- Card Header row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Left section: Sun icon + Section Title -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_sun"
                        android:contentDescription="Sun Icon"
                        app:tint="#616161" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Verse"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1E1E1E"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Right section: Date -->
                <TextView
                    android:id="@+id/daily_verse_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="May 16, 2024"
                    android:textSize="13sp"
                    android:textColor="#9E9E9E"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- Middle Section: Centered Verse Content -->
            <TextView
                android:id="@+id/daily_verse_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:text="For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life."
                android:textSize="20sp"
                android:textColor="#1E1E1E"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <!-- Capsule Chip reference button -->
            <TextView
                android:id="@+id/daily_verse_reference_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="John 3:16"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E1E1E"
                android:background="@drawable/bg_reference_chip"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Bottom Row: Bookmark & Share buttons aligned right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:layout_marginTop="20dp">

                <ImageButton
                    android:id="@+id/btn_bookmark"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_bookmark_border"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Bookmark Verse"
                    app:tint="#616161" />

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_share"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Share Verse"
                    android:layout_marginStart="8dp"
                    app:tint="#616161" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
