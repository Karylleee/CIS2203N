<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header layout -->
    <RelativeLayout
        android:id="@+id/search_header_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/search_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Rounded Search Input Card -->
    <LinearLayout
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_box"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/search_header_layout">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search Icon" />

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Search verses or keywords..."
            android:textSize="15sp"
            android:textColor="#1E1E1E"
            android:textColorHint="#9E9E9E"
            android:background="@android:color/transparent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <ImageButton
            android:id="@+id/btn_voice_search"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_mic"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Search" />
    </LinearLayout>

    <!-- Scope/Category Filter Tabs -->
    <LinearLayout
        android:id="@+id/search_category_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/search_card">

        <TextView
            android:id="@+id/tab_search_verses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verses"
            android:textSize="14sp"
            android:textColor="#1A56DB"
            android:textStyle="bold"
            android:background="@drawable/bg_chapter_active"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_search_keywords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keywords"
            android:textSize="14sp"
            android:textColor="#616161"
            android:background="@drawable/bg_chapter_normal"
            android:layout_marginStart="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_search_topics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Topics"
            android:textSize="14sp"
            android:textColor="#616161"
            android:background="@drawable/bg_chapter_normal"
            android:layout_marginStart="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Scrollable container for Search Home (Empty Query State) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/search_home_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/search_category_tabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Recent searches -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent searches"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recent_searches_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="28dp" />

            <!-- Section 2: Browse by topic -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse by topic"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="16dp" />

            <!-- Elegant capsule tag chips rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/chip_faith"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faith"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:background="@drawable/bg_reference_chip"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_hope"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hope"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:background="@drawable/bg_reference_chip"
                        android:layout_marginStart="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_love"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Love"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:background="@drawable/bg_reference_chip"
                        android:layout_marginStart="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/chip_peace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peace"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:background="@drawable/bg_reference_chip"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_strength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strength"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:background="@drawable/bg_reference_chip"
                        android:layout_marginStart="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_grace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grace"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:background="@drawable/bg_reference_chip"
                        android:layout_marginStart="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_forgiveness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgiveness"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:background="@drawable/bg_reference_chip"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_wisdom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wisdom"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:background="@drawable/bg_reference_chip"
                        android:layout_marginStart="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Verses Search Results Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/search_category_tabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
