<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.bible_application.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_verses"
            app:destination="@id/navigation_verses" />
    </fragment>

    <fragment
        android:id="@+id/navigation_books"
        android:name="com.example.bible_application.ui.books.BooksFragment"
        android:label="Books"
        tools:layout="@layout/fragment_books">
        <action
            android:id="@+id/action_books_to_chapters"
            app:destination="@id/navigation_chapters" />
        <action
            android:id="@+id/action_books_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_chapters"
        android:name="com.example.bible_application.ui.chapters.ChaptersFragment"
        android:label="Chapters"
        tools:layout="@layout/fragment_chapters">
        <argument
            android:name="bookId"
            app:argType="integer" />
        <argument
            android:name="bookName"
            app:argType="string" />
        <action
            android:id="@+id/action_chapters_to_verses"
            app:destination="@id/navigation_verses" />
    </fragment>

    <fragment
        android:id="@+id/navigation_verses"
        android:name="com.example.bible_application.ui.verses.VersesFragment"
        android:label="Verses"
        tools:layout="@layout/fragment_verses">
        <argument
            android:name="bookId"
            app:argType="integer" />
        <argument
            android:name="bookName"
            app:argType="string" />
        <argument
            android:name="chapter"
            app:argType="integer" />
        <action
            android:id="@+id/action_verses_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_verses_to_chapters"
            app:destination="@id/navigation_chapters" />
    </fragment>

    <fragment
        android:id="@+id/navigation_search"
        android:name="com.example.bible_application.ui.search.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/navigation_saved"
        android:name="com.example.bible_application.ui.saved.SavedFragment"
        android:label="Saved"
        tools:layout="@layout/fragment_saved" />

</navigation>
